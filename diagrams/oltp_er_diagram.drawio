ees__employee_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e13" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;html=1;rounded=0;" edge="1" parent="1" source="r_performance_reviews__reviewer_id" target="r_employees__employee_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e14" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#555555;html=1;rounded=0;" edge="1" parent="1" source="r_performance_reviews__project_id" target="r_projects__project_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e15" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;html=1;rounded=0;" edge="1" parent="1" source="r_performance_reviews__rating_id" target="r_performance_rating_levels__rating_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e16" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;html=1;rounded=0;" edge="1" parent="1" source="r_projects__department_id" target="r_departments__department_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e17" value="" style="edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;startArrow=ERzeroToMany;endArrow=ERzeroToOne;startFill=0;endFill=0;strokeColor=#555555;html=1;rounded=0;" edge="1" parent="1" source="r_projects__project_manager_id" target="r_employees__employee_id"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1570" y="837"/><mxPoint x="1570" y="529"/><mxPoint x="1040" y="529"/><mxPoint x="1040" y="147"/></Array></mxGeometry></mxCell><mxCell id="e18" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;html=1;rounded=0;" edge="1" parent="1" source="r_project_assignments__employee_id" target="r_employees__employee_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e19" value="" style="edgeStyle=entityRelationEdgeStyle;startArrow=ERzeroToMany;endArrow=ERmandOne;startFill=0;endFill=0;strokeColor=#555555;html=1;rounded=0;" edge="1" parent="1" source="r_project_assignments__project_id" target="r_projects__project_id"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="legend" value="&lt;b style=&quot;font-size:14px&quot;&gt;Legend&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;span style=&quot;background:#dae8fc;border:1px solid #6c8ebf&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Reference / lookup table&lt;br&gt;&lt;span style=&quot;background:#fff2cc;border:1px solid #d6b656&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Bridge table (M:N)&lt;br&gt;&lt;span style=&quot;background:#d5e8d4;border:1px solid #82b366&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;/span&gt; Core transactional table&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; primary key · &lt;b&gt;FK&lt;/b&gt; foreign key&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; unique · &lt;b&gt;UQ1&lt;/b&gt; columns of one composite unique key&lt;br&gt;&lt;b&gt;GEN&lt;/b&gt; generated column (computed by MySQL)&lt;br&gt;&lt;b&gt;NULL&lt;/b&gt; optional column (all others NOT NULL)&lt;br&gt;&lt;br&gt;&lt;b&gt;Crow's foot notation&lt;/b&gt;&lt;br&gt;|| exactly one · o| zero or one&lt;br&gt;o&amp;lt; zero or many · |&amp;lt; one or many" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#FAFAFA;strokeColor=#BBBBBB;rounded=1;" vertex="1" parent="1"><mxGeometry x="40" y="880" width="410" height="330" as="geometry"/></mxCell><mxCell id="rules" value="&lt;b style=&quot;font-size:14px&quot;&gt;Key integrity rules&lt;/b&gt;&lt;br&gt;&lt;br&gt;• &lt;b&gt;One current version per employee&lt;/b&gt;: current_version_key = employee_id when effective_end_date IS NULL, else NULL; UNIQUE index on it.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Valid department–role pairs only&lt;/b&gt;: composite FK (department_id, job_role_id) → department_job_roles (11 valid pairs).&lt;br&gt;&lt;br&gt;• &lt;b&gt;CHECK constraints&lt;/b&gt;: hire_date ≥ date_of_birth + 18 years; exit_date ≥ hire_date; effective_end_date &amp;gt; effective_start_date; survey scales 1–4; allocation_pct 1–100; kpi_score 0–100; reviewer_id ≠ employee_id; manager_id ≠ employee_id.&lt;br&gt;&lt;br&gt;• &lt;b&gt;Stored procedures&lt;/b&gt; enforce multi-row rules: no overlapping history periods, role level range, salary band.&lt;br&gt;&lt;br&gt;• &lt;b&gt;ON DELETE RESTRICT&lt;/b&gt; on every FK — HR history is never cascade-deleted." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=top;spacing=10;fillColor=#FAFAFA;strokeColor=#BBBBBB;rounded=1;" vertex="1" parent="1"><mxGeometry x="2160" y="460" width="410" height="400" as="geometry"/></mxCell></root></mxGraphModel>