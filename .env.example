# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your password never reaches GitHub.
#
# ---------------------------------------------------------------- local MySQL (development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=hr_app
DB_PASSWORD=your_password_here
#
# ---------------------------------------------------------------- cloud MySQL (Aiven, Phase 5)
# To load the cloud database from your laptop, comment out the four local lines above and use
# these instead (values from Aiven console -> your service -> Overview -> Connection information):
# DB_HOST=mysql-xxxxxxxx-yourname.k.aivencloud.com
# DB_PORT=12345
# DB_USER=avnadmin
# DB_PASSWORD=your_aiven_password
#
# ---------------------------------------------------------------- optional
# Connections in the shared pool, and seconds a request waits for a free one
# DB_POOL_SIZE=5
# DB_POOL_WAIT=10
# Passcode that unlocks data entry on the public site (leave unset locally = data entry open)
# APP_PASSCODE=choose-a-passcode
