# Copy this file to .env and fill in your own values.
# .env is git-ignored, so your password never reaches GitHub.
DB_HOST=localhost
DB_PORT=3306
DB_USER=hr_app
DB_PASSWORD=your_password_here
# Optional: connections in the shared pool, and how many seconds a request waits for a free one
# DB_POOL_SIZE=5
# DB_POOL_WAIT=10
